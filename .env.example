# ============================================================
# NekiNet Environment Variables Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control!
# ============================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Google Maps or Geocoding API if not using free OSM Nominatim
# Leaflet by default uses free OpenStreetMap tiles (no API key required).

# Note: GEMINI_API_KEY is kept strictly server-side inside Supabase Edge Functions.
# It should NEVER be prefixed with VITE_ or exposed to the client bundle.
